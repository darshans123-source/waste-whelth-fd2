# ==========================================
# Waste to Wealth - Environment Variables
# ==========================================

# Server Port
PORT=5000

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# JWT Secret for Session/Token Signing
JWT_SECRET=super_secret_waste_to_wealth_jwt_token_key_2026

# Google OAuth 2.0 Credentials (Optional for Demo Mode, Required for real Google Sign-In)
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Database Path (Local JSON/SQLite Storage)
DATABASE_FILE=./data/gamestate.json
